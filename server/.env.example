# Copy to `.env` for local dev, or set these as environment variables on your host.

# Gmail sender + App Password (https://myaccount.google.com/apppasswords).
# Use the 16 characters with NO spaces.
GMAIL_EMAIL=trackerexpense29@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# Firebase Admin service account, as a single-line JSON string.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON file contents here (keep the surrounding quotes).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"expense-84f73", ...}

# Port (Render/most hosts set this automatically).
PORT=8080
